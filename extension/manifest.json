{
  "manifest_version": 3,
  "name": "Bookit Importer",
  "version": "1.0.0",
  "description": "Import books from Libby and Audible into your Bookit app.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "https://libbyapp.com/*",
    "https://*.libbyapp.com/*",
    "https://www.audible.com/*",
    "https://www.audible.co.uk/*",
    "http://localhost:3001/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://libbyapp.com/*", "https://*.libbyapp.com/*"],
      "js": ["content/libby.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.audible.com/*", "https://www.audible.co.uk/*"],
      "js": ["content/audible.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Bookit Importer"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
