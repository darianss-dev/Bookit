# Server
PORT=3001

# Google Sheets OAuth2 credentials
# Get these from https://console.cloud.google.com
# Create an OAuth 2.0 Client ID (Desktop app), download the JSON, and fill in below.
GOOGLE_CLIENT_ID=your_client_id_here
GOOGLE_CLIENT_SECRET=your_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:3001/auth/google/callback

# Your Google Spreadsheet ID (from the URL: /spreadsheets/d/THIS_PART/edit)
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id_here

# Name of the sheet tab (default: Sheet1)
GOOGLE_SHEET_NAME=Books

# How often to sync with Google Sheets (in minutes, 0 to disable auto-sync)
SYNC_INTERVAL_MINUTES=30

# Extension API key (used so only your extension can push books)
EXTENSION_API_KEY=change_this_to_a_random_secret_string
